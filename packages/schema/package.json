{
  "name": "@coolblock/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the FastAPI OpenAPI schema. Never hand-edited (§11).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo generated"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}

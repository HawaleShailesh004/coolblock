# Copy to .env and fill in. Nothing in this file is a real secret.
# Local values here match docker-compose.yml defaults exactly -- `make dev`
# works with this file copied verbatim, no edits required, for local-only work.

# --- Core ---
NODE_ENV=development
ENVIRONMENT=local

# --- Database (Postgres 16 + PostGIS 3.4 + pgvector) ---
DATABASE_URL=postgresql+psycopg://coolblock:coolblock@localhost:5433/coolblock
POSTGRES_USER=coolblock
POSTGRES_PASSWORD=coolblock
POSTGRES_DB=coolblock

# --- Jobs (ARQ + Redis) ---
REDIS_URL=redis://localhost:6379/0

# Only needed when the ARQ worker runs as its own sleep-on-idle hosted
# service (Render free tier -- see docs/adr/0034-*.md). Set it to that
# service's public URL and a solve request wakes the worker first;
# without it, a solve queued while the worker is asleep stays pending
# forever with no error. Leave blank locally: `make dev`'s worker is a
# plain always-on container and needs no waking.
WORKER_WAKE_URL=

# --- Object storage (MinIO locally = S3-compatible stand-in for Cloudflare R2) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=coolblock
S3_SECRET_ACCESS_KEY=coolblock123
S3_BUCKET_DATA=coolblock-data
S3_BUCKET_TILES=coolblock-tiles
S3_REGION=us-east-1
# In production this becomes an R2 bucket + Cloudflare account credentials.

# --- Raster tiling ---
TITILER_URL=http://localhost:8090

# --- API ---
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Auth (Clerk) -- leave blank for local-only Phase 0; required from Phase 7 ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- LLM (Claude API -- headline sponsor, load-bearing not decorative, §7.1) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NARRATIVE=claude-opus-5
CLAUDE_MODEL_INTERACTIVE=claude-sonnet-5

# --- engine/narrate's provider switch (docs/adr/0019-*.md) ---
# "anthropic" (claude-opus-5, the higher-quality default) or "groq"
# (openai/gpt-oss-120b, much faster, added as a fallback for when the
# Anthropic account's credit balance runs out -- measurably weaker at
# "use only these numbers," which is exactly what L6's provenance guard
# exists to catch regardless of which one is generating).
MEMO_LLM_PROVIDER=anthropic
GROQ_API_KEY=

# --- Symbolic verification (Wolfram Cloud -- optional at Phase 0; see §7.2 fallback) ---
WOLFRAM_APP_ID=

# --- Census / CDC (free, instant keys) ---
CENSUS_API_KEY=

# --- Observability (optional locally) ---
SENTRY_DSN=

# --- Map basemap (Protomaps PMTiles served from local MinIO / R2 in prod) ---
NEXT_PUBLIC_PMTILES_URL=http://localhost:9000/coolblock-tiles/basemap.pmtiles
# Self-hosted glyphs (labels) + sprite (icons) -- run scripts/build_map_assets.sh
# once to populate these under MinIO (docs/adr/0022-*.md's offline-demo-mode fix).
NEXT_PUBLIC_MAP_ASSETS_URL=http://localhost:9000/coolblock-tiles
